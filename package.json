{
  "name": "heatingology",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next node_modules/.cache && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "bash scripts/test.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "docker:db": "docker start heatingology || docker run --name heatingology --mount type=volume,source=heatingology_postgres_data,target=/var/lib/postgresql/data -e POSTGRES_USER=heat-db-user -e POSTGRES_PASSWORD=heat_db_pwd -e POSTGRES_DB=heatingology-db -p 5432:5432  -d postgres:15",
    "generate:db": "npx prisma generate --schema ./prisma",
    "migrate:db": "npx prisma migrate dev --schema ./prisma --name",
    "format:db": "npx prisma format --schema ./prisma",
    "seed:db": "npx prisma db seed",
    "add:db": "tsx prisma/seedAdditional.ts",
    "reset:db": "npx prisma migrate reset --schema ./prisma",
    "deploy:db": "npx prisma migrate deploy --schema ./prisma",
    "push:db": "npx prisma db push --schema ./prisma",
    "verify:db": "npx prisma studio --schema ./prisma",
    "status:db": "npx prisma migrate status --schema ./prisma",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=8192' next build",
    "build:debug": "rm -rf .next && NODE_OPTIONS='--max-old-space-size=8192 --trace-warnings' next build --experimental-debug-memory-usage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.830.0",
    "@aws-sdk/client-ses": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.830.0",
    "@hookform/resolvers": "^5.0.1",
    "@kanda-libs/kanda-utils": "^1.0.2",
    "@paypal/react-paypal-js": "^8.8.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/react-stripe-js": "^3.9.0",
    "@stripe/stripe-js": "^7.8.0",
    "@tanstack/react-query": "^5.80.10",
    "@types/js-cookie": "^3.0.6",
    "@types/nodemailer": "^7.0.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.16.0",
    "js-cookie": "^3.0.5",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.5",
    "prisma": "^6.8.2",
    "react": "^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-intersection-observer": "^9.16.0",
    "react-markdown": "^10.1.0",
    "react-responsive": "^10.0.1",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "stripe": "18.0.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^24.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "sass": "^1.89.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
